<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MerchPlusMAUI.Controls.CommonFooter"
             HeightRequest="60"
             MinimumHeightRequest="60"
             VerticalOptions="End">

    <Grid ColumnDefinitions="*,*,*,*,*"
          RowDefinitions="*"
          BackgroundColor="{StaticResource Primary}"
          Padding="0,5">

        <!-- Ana Sayfa Butonu -->
        <Grid Grid.Column="0" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe88a;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Ana Sayfa"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Harita Butonu -->
        <Grid Grid.Column="1" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe55b;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Harita"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMapClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Görevler Butonu -->
        <Grid Grid.Column="2" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe8f9;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Görevler"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTasksClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Veritabanı Güncelle Butonu -->
        <Grid Grid.Column="3" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe863;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Güncelle"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUpdateDbClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Veritabanı Sil Butonu -->
        <Grid Grid.Column="4" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe872;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Temizle"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDeleteDbClicked"/>
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentView> 