<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MerchPlusMAUI.Controls.CommonFooter"
             HeightRequest="60"
             MinimumHeightRequest="60"
             VerticalOptions="End">

    <Grid ColumnDefinitions="*,*,*,*"
          RowDefinitions="*"
          BackgroundColor="{StaticResource Primary}"
          Padding="0,5">

        <!-- Ana Sayfa Butonu -->
        <Grid Grid.Column="0" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe88a;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Ana Sayfa"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHomeClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Görevler Butonu -->
        <Grid Grid.Column="1" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe8f9;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Görevler"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTasksClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Veritabanı Güncelle Butonu -->
        <Grid Grid.Column="2" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              x:Name="UpdateButtonGrid">
            <Grid Grid.Row="0"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Text="&#xe863;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <!-- Badge - Güncelleme sayısı -->
                <Frame x:Name="UpdateBadge"
                       BackgroundColor="#FF4444"
                       CornerRadius="10"
                       Padding="0"
                       WidthRequest="20"
                       HeightRequest="20"
                       HasShadow="False"
                       BorderColor="Transparent"
                       HorizontalOptions="End"
                       VerticalOptions="Start"
                       Margin="12,-8,0,0"
                       IsVisible="False">
                    <Label x:Name="UpdateBadgeLabel"
                           Text="0"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"/>
                </Frame>
            </Grid>
            <Label Grid.Row="1"
                   x:Name="UpdateButtonLabel"
                   Text="Güncelle"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUpdateDbClicked"/>
            </Grid.GestureRecognizers>
        </Grid>

        <!-- Veritabanı Sil Butonu -->
        <Grid Grid.Column="3" 
              RowDefinitions="Auto,Auto" 
              RowSpacing="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="&#xe872;"
                   FontFamily="MaterialIcons"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Label Grid.Row="1"
                   Text="Temizle"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"/>
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDeleteDbClicked"/>
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentView> 