<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="MerchPlusMAUI.Views.AboutMePage"
             Title=""
             ios:Page.UseSafeArea="False"
             Padding="0"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="70,*,60" Margin="0" Padding="0" RowSpacing="0">
        
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0"/>
        
        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="15,15,15,70" Margin="0" RowSpacing="10">
                
                <!-- 1. MAĞAZALAR KUTUSU -->
                <Frame Grid.Row="0"
                       Padding="10,8" 
                       CornerRadius="10" 
                       BorderColor="#e0e0e0" 
                       HasShadow="True"
                       Margin="0"
                       VerticalOptions="Start">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Başlık ve Info butonu -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <Label Text="Mağazalar"
                                   Grid.Column="0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"/>
                            
                            <!-- Info button - Circular with background -->
                            <Button Grid.Column="1"
                                    Text="&#xe88e;"
                                    FontFamily="MaterialIcons"
                                    FontSize="18"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    CornerRadius="18"
                                    BackgroundColor="Transparent"
                                    TextColor="#1976D2"
                                    Clicked="OnInfoButtonClicked"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                        </Grid>
                        
                        <!-- İçerik Alanı - Büyük Tıklanabilir Butonlar -->
                        <Grid Grid.Row="1" 
                              ColumnSpacing="10" 
                              RowSpacing="0"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Planlanan Butonu -->
                            <Frame Grid.Column="0" 
                                   x:Name="PlannedButtonFrame"
                                   BackgroundColor="#E3F2FD"
                                   CornerRadius="12"
                                   Padding="8,10" 
                                   HasShadow="True"
                                   BorderColor="#BBDEFB"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <StackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="📋"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    <Label Text="Planlanan"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#1976D2"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="NoWrap"/>
                                    <Label x:Name="PlannedCountLabel"
                                           Text="-"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#1976D2"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="NoWrap"
                                           MinimumWidthRequest="30"/>
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlannedTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                            
                            <!-- Tamamlanan Butonu -->
                            <Frame Grid.Column="1"
                                   x:Name="CompletedButtonFrame"
                                   BackgroundColor="#E8F5E9"
                                   CornerRadius="12"
                                   Padding="8,10"
                                   HasShadow="True"
                                   BorderColor="#C8E6C9"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <StackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="✅"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    <Label Text="Tamamlanan"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#388E3C"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="NoWrap"/>
                                    <Label x:Name="CompletedCountLabel"
                                           Text="-"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#388E3C"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="NoWrap"
                                           MinimumWidthRequest="30"/>
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCompletedTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                            
                            <!-- Bekleyen Butonu -->
                            <Frame Grid.Column="2"
                                   x:Name="PendingButtonFrame"
                                   BackgroundColor="#FFF3E0"
                                   CornerRadius="12"
                                   Padding="8,10"
                                   HasShadow="True"
                                   BorderColor="#FFE0B2"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                                <StackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="⏳"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    <Label Text="Bekleyen"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="NoWrap"/>
                                    <Label x:Name="PendingCountLabel"
                                           Text="-"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#F57C00"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="NoWrap"
                                           MinimumWidthRequest="30"/>
                                </StackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPendingTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>
                    </Grid>
                </Frame>
                
                <!-- 2. YARIŞMALAR KUTUSU -->
                <Frame Grid.Row="1"
                       Padding="10" 
                       CornerRadius="10" 
                       BorderColor="#e0e0e0" 
                       HasShadow="True"
                       Margin="0">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Başlık -->
                        <Label Grid.Row="0"
                               Text="Yarışmalar"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Start"
                               VerticalOptions="Center"
                               Margin="0,0,0,5"/>
                        
                        <!-- Yarışmalar İçeriği -->
                        <ScrollView Grid.Row="1">
                            <!-- Yarışma İçeriği -->
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Label Text="Aktif yarışma bulunmamaktadır."
                                       Grid.Row="0"
                                       FontSize="16"
                                       TextColor="Gray"
                                       HorizontalOptions="Center"
                                       IsVisible="True"
                                       x:Name="NoContestLabel"/>
                                       
                                <VerticalStackLayout x:Name="ContestsContainer" 
                                                     Grid.Row="1"
                                                     Spacing="8"
                                                     IsVisible="False">
                                    <!-- Yarışmalar kod tarafında doldurulacak -->
                                </VerticalStackLayout>
                            </Grid>
                        </ScrollView>
                    </Grid>
                </Frame>
        </Grid>
        
        <!-- Footer -->
        <controls:CommonFooter Grid.Row="2"/>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              x:Name="LoadingOverlay"
              BackgroundColor="#80000000"
              IsVisible="True">
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="30"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout Spacing="15" Orientation="Vertical">
                    <ActivityIndicator x:Name="LoadingSpinner"
                                       IsRunning="True"
                                       Color="#DC3545"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Yükleniyor..."
                           FontSize="14"
                           TextColor="#343A40"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage> 