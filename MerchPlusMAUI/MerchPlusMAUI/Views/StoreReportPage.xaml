<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MerchPlusMAUI.Views.StoreReportPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             Title="{Binding PageTitle}"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="70,*,75">
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0" />

        <!-- Main Content - Report List -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <!-- Loading Overlay -->
            <Grid x:Name="LoadingOverlay" 
                  Grid.RowSpan="2"
                  BackgroundColor="#80000000" 
                  IsVisible="True">
                <StackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="20">
                    <ActivityIndicator x:Name="LoadingSpinner" 
                                       IsRunning="True" 
                                       Color="White" 
                                       WidthRequest="50" 
                                       HeightRequest="50"/>
                    <Label Text="Rapor verileri yükleniyor..." 
                           TextColor="White" 
                           FontSize="16" 
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Grid>
            
            <!-- Store Info Card -->
            <Frame Grid.Row="0" 
                   BackgroundColor="White" 
                   Margin="15,10,15,5" 
                   Padding="15" 
                   CornerRadius="10" 
                   HasShadow="True">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <Frame BackgroundColor="#336699" 
                           WidthRequest="50" 
                           HeightRequest="50" 
                           CornerRadius="25" 
                           Padding="0" 
                           HasShadow="False">
                        <Label Text="📊" 
                               FontSize="24" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               TextColor="White"/>
                    </Frame>
                    <StackLayout VerticalOptions="Center" Spacing="5">
                        <Label x:Name="StoreNameLabel" 
                               Text="{Binding StoreName}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#333"/>
                        <Label x:Name="ReportSummaryLabel" 
                               Text="{Binding ReportSummary}" 
                               FontSize="14" 
                               TextColor="#666"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Report List -->
            <ScrollView Grid.Row="1" Margin="15,5,15,10">
                <VerticalStackLayout x:Name="ReportItemsContainer" Spacing="10">
                    <!-- Report items will be populated from code -->
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Bottom Navigation with Entry/Exit Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*,*,*,*" 
              BackgroundColor="{StaticResource Primary}" 
              Padding="0,5"
              RowSpacing="0"
              ColumnSpacing="0">
            
            <!-- Ana Sayfa Butonu -->
            <Grid Grid.Column="0" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe88a;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Ana Sayfa"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeButtonClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Güncelle Butonu -->
            <Grid Grid.Column="1" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe863;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Güncelle"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRefreshButtonClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
            
            <!-- Giriş/Devam Butonu (duruma göre değişir) -->
            <Grid x:Name="EntryContinueButton"
                  Grid.Column="2" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label x:Name="EntryContinueIcon"
                       Grid.Row="0"
                       Text="&#xe89c;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label x:Name="EntryContinueText"
                       Grid.Row="1"
                       Text="Giriş"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEntryContinueButtonClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Çıkış Butonu -->
            <Grid x:Name="ExitButton"
                  Grid.Column="3" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe5cd;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Çıkış"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitButtonClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
            
            <!-- Back to Store Button -->
            <Grid Grid.Column="4" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe8cc;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Mağaza"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToStoreClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Back to Products Button -->
            <Grid Grid.Column="5" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe8f6;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Ürünler"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToProductsClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>
    </Grid>
</ContentPage> 