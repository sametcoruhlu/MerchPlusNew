<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             x:Class="MerchPlusMAUI.Views.MerchDataEntryPage"
             Title="Ürün Veri Girişi"
             BackgroundColor="#F8F9FA">
    
    <Grid RowDefinitions="70,*,75" BackgroundColor="#F8F9FA">
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0" />

        <!-- Main Content -->
        <Grid Grid.Row="1" BackgroundColor="#F8F9FA">
            <!-- Main Content -->
            <ScrollView x:Name="MainContent" 
                        Padding="15" 
                        BackgroundColor="#F8F9FA"
                        IsVisible="False">
                <StackLayout Spacing="20">
                
                <!-- Product Info Card -->
                <Frame BackgroundColor="White" 
                       Padding="15" 
                       CornerRadius="12" 
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <!-- Store Name -->
                        <Label Grid.Row="0"
                               x:Name="RetailShopNameLabel"
                               Text="Mağaza Adı"
                               FontSize="14"
                               TextColor="#6C757D"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        
                        <!-- Product Name -->
                        <Label Grid.Row="1"
                               x:Name="CustomerProductNameLabel"
                               Text="Ürün Adı"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#343A40"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Frame>

                <!-- Data Entry Form -->
                <Frame BackgroundColor="White" 
                       Padding="20" 
                       CornerRadius="12" 
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        
                        <!-- Face Count -->
                        <Grid x:Name="FaceCountGrid" ColumnDefinitions="*,2*" ColumnSpacing="15">
                            <Label Grid.Column="0" 
                                   Text="Önyüz" 
                                   FontSize="16" 
                                   TextColor="#343A40"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   x:Name="FaceCountEntry"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Center"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                        </Grid>

                        <!-- Shelf Index -->
                        <Grid x:Name="ShelfIndexGrid" ColumnDefinitions="*,2*" ColumnSpacing="15">
                            <Label Grid.Column="0" 
                                   Text="Raf Sırası" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   x:Name="ShelfIndexEntry"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Center"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                        </Grid>

                        <!-- Shelf Stock -->
                        <Grid x:Name="ShelfStockGrid" ColumnDefinitions="*,2*" ColumnSpacing="15">
                            <Label Grid.Column="0" 
                                   Text="Raf Stoğu" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   x:Name="ShelfStockEntry"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Center"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                        </Grid>

                        <!-- Price -->
                        <Grid x:Name="PriceGrid" ColumnDefinitions="*,1*,0.1*,1*" ColumnSpacing="5">
                            <Label Grid.Column="0" 
                                   Text="Fiyat" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   x:Name="ShelfPrice1Entry"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="End"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                            <Label Grid.Column="2" 
                                   Text="," 
                                   FontSize="16" 
                                   TextColor="#333"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="3" 
                                   x:Name="ShelfPrice2Entry"
                                   Placeholder="00"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Start"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                        </Grid>

                        <!-- Warehouse Stock -->
                        <Grid x:Name="WarehouseStockGrid" ColumnDefinitions="*,2*" ColumnSpacing="15">
                            <Label Grid.Column="0" 
                                   Text="Depo Stok" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   x:Name="WarehouseStockEntry"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Start"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                        </Grid>

                        <!-- Activity Type -->
                        <Grid x:Name="ActivityTypeGrid" ColumnDefinitions="*,2*" ColumnSpacing="15">
                            <Label Grid.Column="0" 
                                   Text="Aktivite" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Picker Grid.Column="1" 
                                    x:Name="ActivityTypePicker"
                                    Title="Aktivite Seçin"
                                    BackgroundColor="#F8F9FA"
                                    Margin="10"/>
                        </Grid>

                        <!-- Discount Price (Hidden by default) -->
                        <Grid x:Name="DiscountPriceGrid"
                              ColumnDefinitions="*,1*,0.1*,1*" 
                              ColumnSpacing="5"
                              IsVisible="False">
                            <Label Grid.Column="0" 
                                   Text="İndirimli Fiyat" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   x:Name="DiscountPrice1Entry"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="End"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                            <Label Grid.Column="2" 
                                   Text="," 
                                   FontSize="16" 
                                   TextColor="#333"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="3" 
                                   x:Name="DiscountPrice2Entry"
                                   Placeholder="00"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Start"
                                   BackgroundColor="#F8F9FA"
                                   Margin="10"/>
                        </Grid>

                        <!-- Notes -->
                        <Grid x:Name="NotesGrid" ColumnDefinitions="*,2*" ColumnSpacing="15">
                            <Label Grid.Column="0" 
                                   Text="Notlar" 
                                   FontSize="16" 
                                   TextColor="#333"
                                   VerticalOptions="Start"/>
                            <Editor Grid.Column="1" 
                                    x:Name="NotesEditor"
                                    Placeholder="Notlarınızı buraya yazın..."
                                    AutoSize="TextChanges"
                                    BackgroundColor="#F8F9FA"
                                    Margin="10"
                                    MinimumHeightRequest="80"/>
                        </Grid>

                    </StackLayout>
                </Frame>

                </StackLayout>
            </ScrollView>
        </Grid>

        <!-- Footer with Save Button -->
        <Grid Grid.Row="2" 
              BackgroundColor="#F8F9FA" 
              Padding="15,10">
            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Text="KAYDET"
                    BackgroundColor="#DC3545"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    Padding="20,15"
                    Clicked="OnSaveClicked"/>
        </Grid>
        
        <!-- Loading Overlay - Navigation için (en son eklenen, en üstte görünür) -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="3"
              BackgroundColor="#80000000" 
              IsVisible="False"
              InputTransparent="False">
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="30" 
                   HasShadow="True"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"
                   Opacity="1">
                <StackLayout Spacing="15" Orientation="Vertical">
                    <ActivityIndicator x:Name="LoadingSpinner" 
                                       IsRunning="True" 
                                       Color="#DC3545" 
                                       WidthRequest="40" 
                                       HeightRequest="40"
                                       Opacity="1"/>
                    <Label Text="Yükleniyor..." 
                           FontSize="14" 
                           FontAttributes="None"
                           TextColor="#343A40" 
                           Opacity="1"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage> 