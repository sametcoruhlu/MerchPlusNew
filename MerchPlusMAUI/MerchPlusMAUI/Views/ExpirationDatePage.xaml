<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MerchPlusMAUI.Views.ExpirationDatePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             Title="SKT Raporlama"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="70,*,75">
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0" />

        <!-- Main Content -->
        <ScrollView Grid.Row="1"
                    Padding="20,10"
                    BackgroundColor="#F8F9FA">
            <StackLayout Spacing="20">

                <!-- Store Info -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="8">
                        <Label Text="Mağaza"
                               FontSize="14"
                               TextColor="#6C757D" />
                        <Label Text="{Binding StoreName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#343A40" />
                    </StackLayout>
                </Frame>

                <!-- Product Selection -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        <Label Text="Ürün Ekle"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#343A40" />

                        <Label Text="Ürün"
                               FontSize="14"
                               TextColor="#6C757D" />
                        <Picker x:Name="ProductPicker"
                                ItemsSource="{Binding CustomerProducts}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedProduct}"
                                Title="Ürün seçiniz"
                                BackgroundColor="White"
                                TextColor="#343A40" />
                    </StackLayout>
                </Frame>

                <!-- Date Entry -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        <Label Text="Son Kullanma Tarihi"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#343A40" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <StackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Gün"
                                       FontSize="14"
                                       TextColor="#6C757D" />
                                <Entry x:Name="DayEntry"
                                       Text="{Binding DayText}"
                                       Placeholder="GG"
                                       Keyboard="Numeric"
                                       MaxLength="2"
                                       BackgroundColor="White"
                                       TextColor="#343A40" />
                            </StackLayout>

                            <StackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Ay"
                                       FontSize="14"
                                       TextColor="#6C757D" />
                                <Entry x:Name="MonthEntry"
                                       Text="{Binding MonthText}"
                                       Placeholder="AA"
                                       Keyboard="Numeric"
                                       MaxLength="2"
                                       BackgroundColor="White"
                                       TextColor="#343A40" />
                            </StackLayout>

                            <StackLayout Grid.Column="2" Spacing="5">
                                <Label Text="Yıl"
                                       FontSize="14"
                                       TextColor="#6C757D" />
                                <Entry x:Name="YearEntry"
                                       Text="{Binding YearText}"
                                       Placeholder="YYYY"
                                       Keyboard="Numeric"
                                       MaxLength="4"
                                       BackgroundColor="White"
                                       TextColor="#343A40" />
                            </StackLayout>
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- Quantity Entry -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        <Label Text="Adet"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#343A40" />
                        <Entry x:Name="QuantityEntry"
                               Text="{Binding QuantityText}"
                               Placeholder="Adet giriniz"
                               Keyboard="Numeric"
                               BackgroundColor="White"
                               TextColor="#343A40" />
                    </StackLayout>
                </Frame>

                <!-- Add Button -->
                <Button Text="EKLE"
                        Command="{Binding AddCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50" />

                <!-- Expiration List -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="10">
                        <Label Text="Eklenen SKT Kayıtları"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#343A40" />

                        <CollectionView x:Name="ExpirationList"
                                        ItemsSource="{Binding ExpirationItems}"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,5">
                                        <Frame BackgroundColor="#F8F9FA"
                                               Padding="15"
                                               CornerRadius="8"
                                               HasShadow="False"
                                               BorderColor="#E9ECEF">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                                  RowSpacing="5">
                                                <Label Grid.Column="0"
                                                       Grid.Row="0"
                                                       Text="{Binding ProductName}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#343A40" />
                                                <Label Grid.Column="1"
                                                       Grid.Row="0"
                                                       Text="{Binding Quantity, StringFormat='Adet: {0}'}"
                                                       FontSize="14"
                                                       TextColor="#6C757D"
                                                       VerticalOptions="Start"
                                                       HorizontalOptions="End" />
                                                <Label Grid.Column="0"
                                                       Grid.ColumnSpan="2"
                                                       Grid.Row="1"
                                                       Text="{Binding ExpirationDate, StringFormat='SKT: {0:dd.MM.yyyy}'}"
                                                       FontSize="14"
                                                       TextColor="#6C757D"
                                                       Margin="0,5,0,0" />
                                                <Button Grid.Column="1"
                                                        Grid.Row="2"
                                                        Text="Sil"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#DC3545"
                                                        TextColor="White"
                                                        FontSize="12"
                                                        FontAttributes="Bold"
                                                        CornerRadius="5"
                                                        HeightRequest="35"
                                                        WidthRequest="70"
                                                        Padding="0"
                                                        VerticalOptions="Start"
                                                        HorizontalOptions="End"
                                                        Margin="0,5,0,0" />
                                            </Grid>
                                        </Frame>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <StackLayout VerticalOptions="Center"
                                             HorizontalOptions="Center"
                                             Spacing="10"
                                             Margin="20">
                                    <Label Text="📅"
                                           FontSize="48"
                                           HorizontalOptions="Center"
                                           TextColor="#CCC" />
                                    <Label Text="Henüz SKT kaydı eklenmedi"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           TextColor="#666"
                                           HorizontalTextAlignment="Center" />
                                </StackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="{StaticResource Primary}"
              Padding="0,5">
            
            <!-- Take Photo Button -->
            <Grid Grid.Column="0" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe412;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Fotoğraf"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTakePhotoClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Sales Order Button -->
            <Grid Grid.Column="1" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe8cc;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Sipariş"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSalesOrderClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Expiration Date Button -->
            <Grid Grid.Column="2" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe916;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="SKT"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExpirationClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Exit Shop Button -->
            <Grid Grid.Column="3" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe879;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Çıkış"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitShopClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- Loading Indicator -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="30"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout Spacing="15" Orientation="Vertical">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="#DC3545"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Yükleniyor..."
                           FontSize="14"
                           TextColor="#343A40"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>

