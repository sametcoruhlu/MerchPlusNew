<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MerchPlusMAUI.Views.ErrorPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             Title="Hata"
             BackgroundColor="White"
             ios:Page.UseSafeArea="False"
             Padding="0">
    
    <ScrollView Padding="0" Margin="0">
        <VerticalStackLayout Spacing="20" Padding="30" Margin="0">
            
            <!-- Logo -->
            <Image Source="mplus_logo.png" 
                   HeightRequest="80"
                   HorizontalOptions="Center"
                   Margin="0,20,0,30"/>
            
            <!-- Hata İkonu -->
            <Label Text="⚠️" 
                   FontSize="60"
                   HorizontalOptions="Center"
                   TextColor="Red"/>
            
            <!-- Başlık -->
            <Label Text="Uygulama Hatası"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#333333"/>
            
            <!-- Hata Mesajı -->
            <Label x:Name="ErrorMessageLabel"
                   Text="Uygulama başlatılırken bir hata oluştu."
                   FontSize="16"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#666666"
                   Margin="0,10,0,20"/>
            
            <!-- Detaylı Hata Bilgisi -->
            <Frame BackgroundColor="#F5F5F5" 
                   BorderColor="#DDDDDD"
                   CornerRadius="8"
                   Padding="15"
                   Margin="0,10,0,20">
                <VerticalStackLayout>
                    <Label Text="Hata Detayları:"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#333333"
                           Margin="0,0,0,10"/>
                    <Label x:Name="ErrorDetailsLabel"
                           Text="Detay bilgisi yükleniyor..."
                           FontSize="12"
                           TextColor="#666666"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Butonlar -->
            <VerticalStackLayout Spacing="15" Margin="0,20,0,0">
                
                <!-- Tekrar Dene Butonu -->
                <Button x:Name="RetryButton"
                        Text="Tekrar Dene"
                        BackgroundColor="#007ACC"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnRetryClicked"/>
                
                <!-- Ana Sayfaya Git Butonu -->
                <Button x:Name="GoToHomeButton"
                        Text="Ana Sayfaya Git"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnGoToHomeClicked"/>
                
                <!-- Uygulamayı Kapat Butonu -->
                <Button x:Name="ExitButton"
                        Text="Uygulamayı Kapat"
                        BackgroundColor="#DC3545"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="8"
                        Clicked="OnExitClicked"/>
                
            </VerticalStackLayout>
            
            <!-- Yardım Metni -->
            <Label Text="Bu hata devam ederse, lütfen sistem yöneticinizle iletişime geçin."
                   FontSize="12"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="#999999"
                   Margin="0,30,0,0"/>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage> 