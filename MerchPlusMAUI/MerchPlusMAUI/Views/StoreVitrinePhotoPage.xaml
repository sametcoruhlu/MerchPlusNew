<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             x:Class="MerchPlusMAUI.Views.StoreVitrinePhotoPage"
             Title="Raf ve Teşhir Fotoğrafı"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="70,*,75">
        
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0" />

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="30">
                
                <!-- Raf Fotoğrafı Bölümü -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        <Label Text="Raf Fotoğrafı"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#343A40"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        
                        <Button x:Name="ShelfPhotoButton"
                                Text="Raf Fotoğrafı Çek"
                                BackgroundColor="#28A745"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="65"
                                Padding="20,15"
                                VerticalOptions="Center"
                                Clicked="OnShelfPhotoClicked"/>
                    </StackLayout>
                </Frame>

                <!-- Teşhir Fotoğrafı Bölümü -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="15"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        <Label Text="Teşhir Fotoğrafı"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#343A40"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                        
                        <Button x:Name="DisplayPhotoButton"
                                Text="Teşhir Fotoğrafı Çek"
                                BackgroundColor="#DC3545"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="65"
                                Padding="20,15"
                                VerticalOptions="Center"
                                Clicked="OnDisplayPhotoClicked"/>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="{StaticResource Primary}"
              Padding="0,5">
            
            <!-- Take Photo Button -->
            <Grid Grid.Column="0" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe412;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Fotoğraf"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTakePhotoClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Sales Order Button -->
            <Grid Grid.Column="1" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe8cc;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Sipariş"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSalesOrderClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Expiration Date Button -->
            <Grid Grid.Column="2" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe916;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="SKT"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExpirationClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Exit Shop Button -->
            <Grid Grid.Column="3" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe879;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Çıkış"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitShopClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              x:Name="LoadingOverlay"
              BackgroundColor="#80000000"
              IsVisible="True">
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="30"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout Spacing="15" Orientation="Vertical">
                    <ActivityIndicator x:Name="LoadingSpinner"
                                       IsRunning="True"
                                       Color="#DC3545"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Yükleniyor..."
                           FontSize="14"
                           TextColor="#343A40"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
