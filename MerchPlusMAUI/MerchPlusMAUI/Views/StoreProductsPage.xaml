<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MerchPlusMAUI.Views.StoreProductsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             Title="{Binding PageTitle}"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="70,*,75">
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0" />

        <!-- Main Content - Product List -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" x:Name="MainContent" IsVisible="False">
            <!-- Store Info Card -->
            <Frame Grid.Row="0" 
                   BackgroundColor="White" 
                   Margin="15,10,15,5" 
                   Padding="15" 
                   CornerRadius="12" 
                   HasShadow="True"
                   BorderColor="#E9ECEF">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <Frame BackgroundColor="#343A40" 
                           WidthRequest="50" 
                           HeightRequest="50" 
                           CornerRadius="25" 
                           Padding="0" 
                           HasShadow="False">
                        <Label Text="🏪" 
                               FontSize="24" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" 
                               TextColor="White"/>
                    </Frame>
                    <StackLayout VerticalOptions="Center" Spacing="5">
                        <Label x:Name="StoreNameLabel" 
                               Text="{Binding StoreName}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#343A40"/>
                        <Label x:Name="ProductCountLabel" 
                               Text="{Binding ProductCountText}" 
                               FontSize="14" 
                               TextColor="#6C757D"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Tab Buttons -->
            <Grid Grid.Row="1" 
                  ColumnDefinitions="*,*" 
                  Margin="15,5,15,5"
                  ColumnSpacing="10">
                <!-- Bekleyen Tab -->
                <Frame Grid.Column="0"
                       x:Name="PendingTabFrame"
                       BackgroundColor="#336699"
                       CornerRadius="10"
                       Padding="15"
                       HasShadow="True">
                    <Label x:Name="PendingTabLabel"
                           Text="⏳ Bekleyen"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPendingTabTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>
                
                <!-- Tamamlanan Tab -->
                <Frame Grid.Column="1"
                       x:Name="CompletedTabFrame"
                       BackgroundColor="#E9ECEF"
                       CornerRadius="10"
                       Padding="15"
                       HasShadow="True">
                    <Label x:Name="CompletedTabLabel"
                           Text="✅ Tamamlanan"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#6C757D"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCompletedTabTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>
            </Grid>

            <!-- Search Bar -->
            <Frame Grid.Row="2" 
                   BackgroundColor="White" 
                   Margin="15,0,15,10" 
                   CornerRadius="10" 
                   HasShadow="True"
                   IsVisible="{Binding HasProducts}"
                   Padding="0"
                   BorderColor="Transparent">
                <SearchBar x:Name="ProductSearchBar"
                           Placeholder="Ürün ara..."
                           PlaceholderColor="#999"
                           TextColor="#333"
                           BackgroundColor="Transparent"
                           Keyboard="{x:Static Keyboard.Text}"
                           TextChanged="OnSearchTextChanged"/>
            </Frame>

            <!-- Product List -->
            <CollectionView x:Name="ProductsCollectionView" 
                            Grid.Row="3"
                            ItemsSource="{Binding FilteredProducts}"
                            BackgroundColor="Transparent"
                            Margin="15,0,15,10"
                            SelectionMode="Single"
                            SelectionChanged="OnProductSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,5">
                            <Frame BackgroundColor="White" 
                                   Padding="15" 
                                   CornerRadius="10" 
                                   HasShadow="True">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProductCardTapped"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="60,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="15">
                                    
                                    <!-- Product Image -->
                                    <Frame Grid.Column="0" 
                                           Grid.RowSpan="3" 
                                           BackgroundColor="#F0F0F0" 
                                           WidthRequest="60" 
                                           HeightRequest="60" 
                                           CornerRadius="8" 
                                           Padding="0" 
                                           HasShadow="False">
                                        <Image Source="{Binding ProductImage}" 
                                               Aspect="AspectFill" 
                                               BackgroundColor="Transparent"/>
                                    </Frame>

                                    <!-- Product Name -->
                                    <Label Grid.Column="1" 
                                           Grid.Row="0" 
                                           Text="{Binding ProductName}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#333" 
                                           LineBreakMode="TailTruncation"/>

                                    <!-- Product Code -->
                                    <Label Grid.Column="1" 
                                           Grid.Row="1" 
                                           Text="{Binding ProductCode, StringFormat='Kod: {0}'}" 
                                           FontSize="14" 
                                           TextColor="#666"/>

                                    <!-- Product Category -->
                                    <Label Grid.Column="1" 
                                           Grid.Row="2" 
                                           Text="{Binding ProductCategory}" 
                                           FontSize="12" 
                                           TextColor="#999" 
                                           />

                                    <!-- Arrow Icon -->
                                    <Label Grid.Column="2" 
                                           Grid.RowSpan="3" 
                                           Text="▶" 
                                           FontSize="16" 
                                           TextColor="#336699" 
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="CenterAndExpand" 
                                 HorizontalOptions="CenterAndExpand" 
                                 Spacing="20"
                                 Margin="20">
                        <Label Text="📦" 
                               FontSize="48" 
                               HorizontalOptions="Center" 
                               TextColor="#CCC"/>
                        <Label Text="Bu mağaza için ürün bulunamadı" 
                               FontSize="16" 
                               HorizontalOptions="Center" 
                               TextColor="#666" 
                               HorizontalTextAlignment="Center"/>
                        <Label x:Name="EmptyStateSubtitle" 
                               Text="Arama kriterlerinizi değiştirmeyi deneyin" 
                               FontSize="14" 
                               HorizontalOptions="Center" 
                               TextColor="#999" 
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding IsSearchActive}"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*,*,*"
              BackgroundColor="{StaticResource Primary}"
              Padding="0,5">
            
            <!-- Take Photo Button -->
            <Grid Grid.Column="0" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe412;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Fotoğraf"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTakePhotoClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Sales Order Button -->
            <Grid Grid.Column="1" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe8cc;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Sipariş"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSalesOrderClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Expiration Date Button -->
            <Grid Grid.Column="2" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe916;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="SKT"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExpirationClicked"/>
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Exit Shop Button -->
            <Grid Grid.Column="3" 
                  RowDefinitions="Auto,Auto" 
                  RowSpacing="2"
                  HorizontalOptions="Center"
                  VerticalOptions="Center">
                <Label Grid.Row="0"
                       Text="&#xe879;"
                       FontFamily="MaterialIcons"
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Center"/>
                <Label Grid.Row="1"
                       Text="Çıkış"
                       TextColor="White"
                       FontSize="12"
                       HorizontalOptions="Center"/>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnExitShopClicked"/>
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- Loading Overlay - Navigation ve veri yükleme için (en son eklenen, en üstte görünür) -->
        <Grid x:Name="LoadingOverlay" 
              Grid.RowSpan="3"
              BackgroundColor="#80000000" 
              IsVisible="False"
              InputTransparent="False">
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="30" 
                   HasShadow="True"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center">
                <StackLayout Spacing="15" Orientation="Vertical">
                    <ActivityIndicator x:Name="LoadingSpinner" 
                                       IsRunning="True" 
                                       Color="#DC3545" 
                                       WidthRequest="40" 
                                       HeightRequest="40"/>
                    <Label Text="Yükleniyor..." 
                           FontSize="14" 
                           TextColor="#343A40" 
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage> 