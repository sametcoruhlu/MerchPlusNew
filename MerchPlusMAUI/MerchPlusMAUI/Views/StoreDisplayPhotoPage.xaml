<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MerchPlusMAUI.Views.StoreDisplayPhotoPage"
             Title="Teşhir Fotoğrafı"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="#343A40"
               Padding="20,15"
               CornerRadius="0"
               HasShadow="True"
               Margin="0">
            <Label Text="Teşhir Fotoğrafı"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
        </Frame>

        <!-- Main Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="20">
                
                <!-- Teşhir Seçimi Bölümü -->
                <Frame BackgroundColor="White"
                       Padding="15"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="10">
                        <Label Text="Teşhir Seçiniz"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#343A40"/>
                        
                        <Frame BackgroundColor="#F8F9FA"
                               BorderColor="#DEE2E6"
                               CornerRadius="8"
                               Padding="15">
                            <Grid>
                                <Label x:Name="PromotionTypeLabel"
                                       Text="Teşhir Tipi Seçimi İçin Tıklayın"
                                       FontSize="14"
                                       TextColor="#6C757D"
                                       VerticalOptions="Center"/>
                                <Label x:Name="SelectedPromotionLabel"
                                       Text=""
                                       FontSize="14"
                                       TextColor="#343A40"
                                       VerticalOptions="Center"
                                       IsVisible="False"/>
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPromotionTypeClicked"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </StackLayout>
                </Frame>

                <!-- Ürün Seçimi Bölümü -->
                <Frame BackgroundColor="White"
                       Padding="15"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="10">
                        <Label Text="Ürün Seçiniz"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#343A40"/>
                        
                        <Frame BackgroundColor="#F8F9FA"
                               BorderColor="#DEE2E6"
                               CornerRadius="8"
                               Padding="15">
                            <Grid>
                                <Label x:Name="ProductSelectionLabel"
                                       Text="Ürün Seçimi İçin Tıklayın"
                                       FontSize="14"
                                       TextColor="#6C757D"
                                       VerticalOptions="Center"/>
                                <Label x:Name="SelectedProductsLabel"
                                       Text=""
                                       FontSize="14"
                                       TextColor="#343A40"
                                       VerticalOptions="Center"
                                       IsVisible="False"/>
                            </Grid>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProductSelectionClicked"/>
                            </Frame.GestureRecognizers>
                        </Frame>
                    </StackLayout>
                </Frame>

                <!-- Fotoğraf Listesi -->
                <Frame BackgroundColor="White"
                       Padding="15"
                       CornerRadius="12"
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="10">
                        <Label Text="Çekilen Fotoğraflar"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#343A40"/>
                        
                        <CollectionView x:Name="PhotoListView"
                                        HeightRequest="200"
                                        BackgroundColor="Transparent">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" 
                                          Padding="10"
                                          BackgroundColor="#F8F9FA"
                                          Margin="0,2">
                                        <Image Grid.Column="0"
                                               Source="{Binding PhotoSource}"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               Aspect="AspectFill"/>
                                        <StackLayout Grid.Column="1" 
                                                     VerticalOptions="Center"
                                                     Margin="10,0">
                                            <Label Text="{Binding ProductName}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#343A40"/>
                                            <Label Text="{Binding PromotionType}"
                                                   FontSize="12"
                                                   TextColor="#6C757D"/>
                                        </StackLayout>
                                        <Button Grid.Column="2"
                                                Text="Sil"
                                                BackgroundColor="#DC3545"
                                                TextColor="White"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                WidthRequest="70"
                                                HeightRequest="35"
                                                Padding="8,5"
                                                Clicked="OnDeletePhotoClicked"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>
                </Frame>

                <!-- Fotoğraf Çek Butonu -->
                <Button x:Name="TakePhotoButton"
                        Text="Fotoğraf Çek"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnTakePhotoClicked"/>

            </StackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Frame Grid.Row="2"
               BackgroundColor="#343A40"
               Padding="20,15"
               CornerRadius="0"
               HasShadow="True">
            <!-- Kaydet Butonu -->
            <Button x:Name="SaveButton"
                    Text="KAYDET"
                    BackgroundColor="#DC3545"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Clicked="OnSaveClicked"/>
        </Frame>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              x:Name="LoadingOverlay"
              BackgroundColor="#80000000"
              IsVisible="True">
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="30"
                   HasShadow="True"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout Spacing="15" Orientation="Vertical">
                    <ActivityIndicator x:Name="LoadingSpinner"
                                       IsRunning="True"
                                       Color="#DC3545"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Veriler yükleniyor..."
                           FontSize="14"
                           TextColor="#343A40"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
