<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="MerchPlusMAUI.Views.StoreEntryPhotoPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MerchPlusMAUI.Controls"
             Title="Mağaza Giriş Fotoğrafı"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="70,*,75">
        <!-- Header -->
        <controls:CommonHeader Grid.Row="0" />

        <!-- Main Content -->
        <ScrollView Grid.Row="1" 
                    Padding="20" 
                    BackgroundColor="#F8F9FA">
            <StackLayout Spacing="30" 
                         VerticalOptions="CenterAndExpand"
                         HorizontalOptions="Fill">

                <!-- Page Title Card -->
                <Frame BackgroundColor="White" 
                       Padding="25" 
                       CornerRadius="12" 
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="15">
                        <Label Text="📸" 
                               FontSize="48" 
                               HorizontalOptions="Center" 
                               TextColor="#DC3545"/>
                        
                        <Label Text="Mağaza Giriş Fotoğrafı" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="#343A40"
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center"/>
                        
                        <Label Text="Mağazaya yapılan ziyaretlerde giriş sırasında fotoğraf çekilmesi zorunludur. Fotoğraf Çek butonuna tıklayarak giriş yaptığınız pozisyonun YATAY fotoğrafını çekiniz." 
                               FontSize="16" 
                               TextColor="#6C757D"
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>
                    </StackLayout>
                </Frame>

                <!-- Camera Button Card -->
                <Frame BackgroundColor="White" 
                       Padding="30" 
                       CornerRadius="12" 
                       HasShadow="True"
                       BorderColor="#E9ECEF">
                    <StackLayout Spacing="20">
                        <Button x:Name="TakePhotoButton"
                                Text="Fotoğraf Çek"
                                BackgroundColor="#DC3545"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                CornerRadius="25"
                                HeightRequest="60"
                                Clicked="OnTakePhotoClicked"/>
                        
                        <Label Text="Yatay fotoğraf çekmek için butona tıklayın" 
                               FontSize="14" 
                               TextColor="#6C757D"
                               HorizontalOptions="Center" 
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Frame>

                <!-- Photo Preview Card (Hidden by default) -->
                <Frame x:Name="PhotoPreviewFrame"
                       BackgroundColor="White" 
                       Padding="20" 
                       CornerRadius="12" 
                       HasShadow="True"
                       BorderColor="#E9ECEF"
                       IsVisible="False">
                    <StackLayout Spacing="15">
                        <Label Text="Çekilen Fotoğraf" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#343A40"
                               HorizontalOptions="Center"/>
                        
                        <Image x:Name="PhotoPreviewImage"
                               HeightRequest="200"
                               Aspect="AspectFit"
                               BackgroundColor="#F8F9FA"/>
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                            <Button Grid.Column="0"
                                    Text="Sil"
                                    BackgroundColor="#6C757D"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="45"
                                    Clicked="OnDeletePhotoClicked"/>
                            
                            <Button Grid.Column="1"
                                    Text="Kaydet"
                                    BackgroundColor="#28A745"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="45"
                                    Clicked="OnSavePhotoClicked"/>
                        </Grid>
                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*" 
              BackgroundColor="White" 
              Padding="15,10">
            
            <!-- Back Button -->
            <Button Grid.Column="0"
                    Text="Geri"
                    BackgroundColor="#6C757D"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    Margin="0,0,7,0"
                    Clicked="OnBackClicked"/>
            
            <!-- Finish Button -->
            <Button Grid.Column="1"
                    Text="Tamamla"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"
                    Margin="7,0,0,0"
                    Clicked="OnFinishClicked"/>
        </Grid>
    </Grid>
</ContentPage>
