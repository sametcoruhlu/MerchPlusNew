<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default collection includes .ico files - this can cause build issues with MacCatalyst. 
		You can include a custom collection instead (or remove the DefaultItemExcludes property completely if you know what you're doing)
		<DefaultItemExcludes>$(DefaultItemExcludes);**/*.ico</DefaultItemExcludes>
		-->

		<OutputType>Exe</OutputType>
		<RootNamespace>MerchPlusMAUI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		
		<!-- Dağıtım ayarları -->
		<DeployOnBuild>true</DeployOnBuild>
		<DeployTargetId Condition="$(TargetFramework.Contains('-android'))">android</DeployTargetId>
		<DeployTargetId Condition="$(TargetFramework.Contains('-ios'))">iphone</DeployTargetId>
		<DeployTargetId Condition="$(TargetFramework.Contains('-maccatalyst'))">mac</DeployTargetId>
		<DeployTargetId Condition="$(TargetFramework.Contains('-windows'))">windows</DeployTargetId>
		<RunAOTCompilation Condition="$(TargetFramework.Contains('-android'))">false</RunAOTCompilation>
		
		<!-- Android spesifik ayarlar -->
		<AndroidProjectFolder Condition="$(TargetFramework.Contains('-android'))">Platforms\Android</AndroidProjectFolder>
		<AndroidEnableDeployment Condition="$(TargetFramework.Contains('-android'))">true</AndroidEnableDeployment>
		<AndroidEnableMultiDex Condition="$(TargetFramework.Contains('-android'))">true</AndroidEnableMultiDex>
		<AndroidUseSharedRuntime Condition="$(TargetFramework.Contains('-android'))">true</AndroidUseSharedRuntime>
		<AndroidLinkMode Condition="$(TargetFramework.Contains('-android'))">None</AndroidLinkMode>
		<EmbedAssembliesIntoApk Condition="$(TargetFramework.Contains('-android'))">false</EmbedAssembliesIntoApk>
		<AndroidCreatePackagePerAbi Condition="$(TargetFramework.Contains('-android'))">false</AndroidCreatePackagePerAbi>
		<AndroidSupportedAbis Condition="$(TargetFramework.Contains('-android'))">arm64-v8a</AndroidSupportedAbis>
		<AndroidUseAapt2 Condition="$(TargetFramework.Contains('-android'))">true</AndroidUseAapt2>
		<AndroidUseApkSigner Condition="$(TargetFramework.Contains('-android'))">true</AndroidUseApkSigner>
		<AndroidDexTool Condition="$(TargetFramework.Contains('-android'))">d8</AndroidDexTool>
		<AndroidUseManagedDesignTimeResourceGenerator Condition="$(TargetFramework.Contains('-android'))">true</AndroidUseManagedDesignTimeResourceGenerator>
		<AndroidGenerateJniMarshalMethods Condition="$(TargetFramework.Contains('-android'))">false</AndroidGenerateJniMarshalMethods>
		<AndroidGeneratePackageManagerJava Condition="$(TargetFramework.Contains('-android'))">false</AndroidGeneratePackageManagerJava>
		<IsPublishable>true</IsPublishable>

		<!-- Display name -->
		<ApplicationTitle>MerchPlusMAUI</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.merchplusmaui</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		
		<!-- Build Performance Optimizations -->
		<UseSharedCompilation>true</UseSharedCompilation>
		<BuildInParallel>true</BuildInParallel>
		<MultiTargetRoslynComponents>true</MultiTargetRoslynComponents>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ProduceReferenceAssembly>false</ProduceReferenceAssembly>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		
		<!-- Disable unnecessary checks for faster builds -->
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<MauiEnableVisualStudioHotReload>false</MauiEnableVisualStudioHotReload>
		
		<!-- Debug optimizations -->
		<DebugType Condition="'$(Configuration)' == 'Debug'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Debug'">false</DebugSymbols>
		<Optimize Condition="'$(Configuration)' == 'Debug'">true</Optimize>
	</PropertyGroup>

	<!-- Startup proje ayarı -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-android|AnyCPU'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="Platforms\Android\Resources\drawable\splash_screen.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="7.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="8.0.91" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="8.0.91" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.91" />
		<PackageReference Include="Microsoft.Maui.Graphics" Version="8.0.91" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
	</ItemGroup>

	<!-- Android specific packages -->
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\entMerchPlus\entMerchPlus.csproj" />
	</ItemGroup>

	<!-- Android specific configurations -->
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<Using Include="Android.App" />
		<Using Include="Android.Content" />
		<Using Include="Android.OS" />
		<Using Include="Android.Runtime" />
		<Using Include="Android.Views" />
		<Using Include="Android.Widget" />
		<Using Include="Android.Provider" />
		<Using Include="Android.Database" />
		<Using Include="Android.Graphics" />
	</ItemGroup>

</Project>
